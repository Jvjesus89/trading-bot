# ============================================
# TRADING BOT - Configuração de Ambiente
# Copie este arquivo para .env e preencha
# ============================================

# --- Modo de Operação ---
# LIVE = execução real na Binance
# PAPER = simulação local (sem ordens reais)
TRADING_MODE=PAPER

# --- Teste / Flexibilização no Modo Paper ---
# Se true, ignora o filtro da EMA200 (1h)
PAPER_IGNORE_EMA200=false

# --- Parâmetros de Entrada e Reversão à Média ---
RSI_THRESHOLD=32.0
RSI_REVERSAL_THRESHOLD=30.0
REQUIRE_GREEN_CANDLE=true
RVOL_THRESHOLD=1.0

# --- Gestão de Saída Segura (Proteção contra Spread em SOL/BRL) ---
SL_ATR_MULT=2.0
SL_MIN_PCT=1.5
TP_ATR_MULT=2.5
TP_MIN_PCT=2.5
BE_ATR_MULT=1.0
TRAILING_ATR_MULT=1.2

# --- Binance API ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# --- Par de Trading ---
SYMBOL=SOL/BRL
BASE_CURRENCY=SOL
QUOTE_CURRENCY=BRL

# --- Capital e Risco ---
BANCA_INICIAL=100.00
ORDEM_PERCENTUAL=25
DRAWDOWN_DIARIO_MAX=6.0
COOLDOWN_STOPS_CONSECUTIVOS=2
COOLDOWN_HORAS=2

# --- DeepSeek (Auditoria de IA por Entrada) ---
# true = cada compra é auditada pelo DeepSeek antes da execução (RSI, RVOL e
# tendência do BTC 4h). false = PAPER opera sem auditoria; LIVE bloqueia.
# Sem DEEPSEEK_API_KEY: PAPER entra sem auditoria e LIVE bloqueia por segurança.
AI_VALIDATION_ENABLED=true
# Cole aqui a chave da plataforma DeepSeek (https://platform.deepseek.com).
# Vazia = PAPER opera sem auditoria e LIVE bloqueia; nunca use placeholder.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_TIMEOUT=15

# --- Supabase (Persistência) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# --- Telegram (Notificações) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Healthcheck (Heartbeat) ---
HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
