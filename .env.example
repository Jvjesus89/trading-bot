# ============================================
# TRADING BOT - Configuração de Ambiente
# Copie este arquivo para .env e preencha
# ============================================

# --- Modo de Operação ---
# LIVE = execução real na Binance
# PAPER = simulação local (sem ordens reais)
TRADING_MODE=PAPER

# --- Binance API ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# --- Par de Trading ---
SYMBOL=SOL/BRL
BASE_CURRENCY=SOL
QUOTE_CURRENCY=BRL

# --- Capital e Risco ---
BANCA_INICIAL=100.00
ORDEM_PERCENTUAL=25
DRAWDOWN_DIARIO_MAX=6.0
COOLDOWN_STOPS_CONSECUTIVOS=2
COOLDOWN_HORAS=2

# --- Google Gemini (IA Macro) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- Supabase (Persistência) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# --- Telegram (Notificações) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Healthcheck (Heartbeat) ---
HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
