# ============================================
# TRADING BOT - Configuração de Ambiente
# Copie este arquivo para .env e preencha
# ============================================

# --- Modo de Operação ---
# LIVE = execução real na Binance
# PAPER = simulação local (sem ordens reais)
TRADING_MODE=PAPER

# --- Binance API ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# --- Par de Trading ---
SYMBOL=SOL/BRL
BASE_CURRENCY=SOL
QUOTE_CURRENCY=BRL

# --- Capital e Risco ---
BANCA_INICIAL=100.00
ORDEM_PERCENTUAL=25
DRAWDOWN_DIARIO_MAX=6.0
COOLDOWN_STOPS_CONSECUTIVOS=2
COOLDOWN_HORAS=2

# --- Estratégia v2 (melhorias) ---
# Custos reais: taxa Binance por lado e custo total ida+volta (taxas + spread)
TAXA_POR_LADO_PCT=0.10
CUSTO_IDA_VOLTA_PCT=0.30
# Sinais só em candles fechados + candle de reversão (verde) após o toque na banda
SINAL_CANDLE_FECHADO=true
EXIGIR_REVERSAO=true
# Alvo = banda média; só entra se o alvo pagar >= 2x os custos e >= 0.8x o risco
ALVO_NA_MEDIA=true
MIN_ALVO_MULT_CUSTO=2.0
MIN_RR=0.8
# Breakeven: stop vai p/ entrada + 0.30% depois de lucro >= 2x custo
BE_OFFSET_PCT=0.30
BE_MIN_MULT_CUSTO=2.0
TRAILING_ATR_MULT=0.5
# Filtro macro por regras (true = volta a usar o Gemini)
USAR_IA=false
BTC_QUEDA_MAX_4H_PCT=-3.0
ATR_CHOQUE_MULT=3.0

# --- Google Gemini (IA Macro, só se USAR_IA=true) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Supabase (Persistência) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# --- Telegram (Notificações) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Healthcheck (Heartbeat) ---
HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
